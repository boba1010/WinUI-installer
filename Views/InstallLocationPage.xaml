<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_installer.Views.InstallLocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_installer.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinUI_installer.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InstallerViewModel}"
    mc:Ignorable="d">

    <Grid
        Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Border 
            Margin="10">
            <TextBlock 
                HorizontalAlignment="Left"
                FontWeight="Bold"
                FontSize="18"
                Text="Choose installation location" />
        </Border>

        <Grid
            Padding="10"
            Margin="10"
            Grid.Row="1"
            ColumnSpacing="5"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox 
                Height="30"
                Text="{Binding FolderPath, Mode=TwoWay}" />
            <Button 
                Grid.Column="1"
                Content="Browse"
                Command="{Binding BrowseFoldersCommand}" />
            <TextBlock 
                Grid.ColumnSpan="2"
                Grid.Row="1"
                Text="{Binding StatusMessage}" />
        </Grid>

        <StackPanel
            Padding="10"
            Grid.Row="1"
            Orientation="Horizontal"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Spacing="10">
            <Button 
                Click="OnBackButtonClicked"
                Content="Back" />
            <Button 
                Click="OnInstallButtonClicked"
                Content="Install" />
            <Button 
                Click="OnCancelButtonClick"
                Content="Cancel" />
        </StackPanel>
    </Grid>
</Page>
