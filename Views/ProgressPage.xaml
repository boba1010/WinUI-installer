<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI_installer.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_installer.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinUI_installer.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InstallerViewModel}"
    mc:Ignorable="d">

    <Grid
        Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border 
            Margin="10">
            <TextBlock 
                HorizontalAlignment="Left"
                FontWeight="Bold"
                FontSize="18"
                Text="Installing your app" />
        </Border>

        <Grid
            Padding="10"
            Margin="10"
            Grid.Row="1"
            ColumnSpacing="5"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar 
                Maximum="100" 
                Value="{Binding ProgressPrecentage}" />
            <TextBlock 
                Grid.Row="1"
                Text="{Binding StatusMessage}" />
        </Grid>

        <StackPanel
            Padding="10"
            Grid.Row="1"
            Orientation="Horizontal"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Spacing="10">
            <Button 
                Click="OnCancelButtonClick"
                Content="Cancel" />
        </StackPanel>
    </Grid>
</Page>
